# SPDX-License-Identifier: Apache-2.0
# maply local configuration. Copy to .env and fill in secrets. Never commit .env.

# --- Service -----------------------------------------------------------------

# From @BotFather. Use the test bot locally, never the production one.
TELEGRAM_BOT_TOKEN=

# docker-compose.yml sets this for the bundled PostgreSQL. Production builds it
# from MAPLY_CORE_PASSWORD in deploy/ws04/compose.yaml. search_path is always
# set to maply by the service.
# DATABASE_URL=postgres://maply:maply@localhost:5432/maply?sslmode=disable

# Production only: the password of the maply_core role in core-postgres.
# MAPLY_CORE_PASSWORD=

# Defaults: :8080, info, true, https://api.telegram.org.
# HTTP_ADDR=:8080
# LOG_LEVEL=info
# AUTO_MIGRATE=true
# TELEGRAM_API_BASE=https://api.telegram.org

# Directory of place images, one file per random key. Empty serves none.
# IMAGES_DIR=/var/lib/maply/images

# Public https address of the Mini App, opened by the Play button. Empty leaves
# the button out.
# APP_URL=

# Send the day's post, intrigue and result to every chat.
# SCHEDULE=true

# The result card: DevTools address of a headless Chromium, and where that
# browser reaches this service. Both empty (the default) sends the place's
# photo and shares through t.me/share. The WS04 stack runs the browser itself;
# locally, start Chrome with --headless --remote-debugging-port=9222 and use
# http://127.0.0.1:9222 with http://127.0.0.1:8080.
# CARD_RENDERER_URL=
# CARD_PAGE_URL=

# Animated posts: the morning post, the intrigue of the time there and the
# result go out as looping animations encoded by ffmpeg, which the image
# carries. false, or no ffmpeg, sends photos and text instead.
# ANIMATIONS=true
# FFMPEG=ffmpeg

# --- Curation scripts --------------------------------------------------------

# Mapillary application "maply": client token with READ scope only.
# https://www.mapillary.com/dashboard/developers
MAPILLARY_CLIENT_ID=
MAPILLARY_TOKEN=

# harvest.py: comma-separated region names from scripts/curation/regions.py
# to collect a batch for only part of the world. Empty means every region.
MAPLY_REGIONS=
